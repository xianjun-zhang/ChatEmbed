#!/usr/bin/env sh
# Husky pre-commit hook (v10-ready)
set -e

# 1️⃣ Lint (report only) — fails on errors, allows warnings
pnpm lint

# 2️⃣ Auto-fix any remaining issues
pnpm lint:fix

# 3️⃣ Apply Prettier formatting
pnpm format

# 4️⃣ Verify formatting (will fail commit if still off)
pnpm format:check

echo "✅ Pre-commit checks passed"

# Remove auto-staging – user decides what to add

echo "🎨 Formatting"
pnpm format                     # writes fixes

# Optionally, run prettier check but do not fail commit
echo "Pre-commit auto-fixes complete – review & stage desired files."
exit 0
